# Builds the offline settlement engine (elo-web-service/pkg/settlement) as a
# WebAssembly module for the frontend (ADR-38): the browser runs the exact
# same settlement math as the server, so offline-computed ratings cannot
# drift. Outputs settlement.wasm plus the matching Go wasm_exec.js runtime —
# the frontend derivation copies both into nextjs/public/wasm/ before
# `next build` (the service worker caches them at runtime, CacheFirst; make
# build-wasm writes the same pair locally for `next dev`).
{
  buildGoApplication,
  go,
  version,
}:

(buildGoApplication {
  pname = "elo-settlement-wasm";
  inherit version go;

  src = ../elo-web-service;

  # gomod2nix.toml is generated by `gomod2nix generate` in elo-web-service/
  # and must be committed alongside go.mod and go.sum.
  modules = ../elo-web-service/gomod2nix.toml;

  # Pure Go — no cgo, no C toolchain needed.
  CGO_ENABLED = "0";

  subPackages = [ "cmd/settlementwasm" ];

  # Skip the unit-test check phase: pkg/settlement's tests run host-side in
  # `make test`; here the unit of verification is the cross-build itself.
  doCheck = false;

  postInstall = ''
    # The go install hook drops cross-built binaries into bin/<GOOS>_<GOARCH>/.
    mv "$out"/bin/*/settlementwasm $out/settlement.wasm
    rm -r $out/bin
    # Ship the wasm_exec.js runtime of the exact toolchain that built the
    # module — the browser loader pairs the two.
    cp "${go}/share/go/lib/wasm/wasm_exec.js" $out/wasm_exec.js
  '';
}).overrideAttrs
  (
    previousAttrs: {
      # Cross-compile to the browser wasm target. Set via overrideAttrs:
      # buildGoApplication pins GOOS/GOARCH to the host platform internally,
      # so plain derivation attrs are clobbered. pkg/id's pgtype-backed Scan
      # is excluded from this target by build tag — the wasm build never
      # scans from a database.
      GOOS = "js";
      GOARCH = "wasm";
    }
  )
