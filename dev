#!/usr/bin/env bash
# Quieter devenv — a transparent wrapper with no project-specific logic.
# devenv -q drops the ~10 setup/eval lines devenv prints per invocation (task
# progress lines print regardless), and the grep drops the upgrade banner
# devenv prints on stderr whenever it is outdated.
#
#   ./dev shell -- bash -lc 'go test -C elo-web-service ./...'
#   ./dev test          # plain `devenv test`: environment self-check
#   ./dev up, ./dev info, ...
#
# The project's command surface (dev stack, test gate, integration tests)
# lives in the Makefile; `make test` runs the suite + gofmt gate inside this
# wrapper.
#
# DEVENV_VERBOSE=1 ./dev ...  → devenv's usual output, unfiltered.
set -e
if [ "${DEVENV_VERBOSE:-0}" = "1" ] || [ "$#" -eq 0 ]; then
    exec devenv "$@"
fi
exec devenv -q "$@" 2> >(grep --line-buffered -v -e 'is out of date\. Please update to')
