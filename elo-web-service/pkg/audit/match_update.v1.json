{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elo/audit/match-update.v1.json",
  "title": "Audit match-update details (v1)",
  "description": "What changed in one match edit. Untouched fields stay null/false; an edit that changed nothing produces no audit row.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "player_changes", "calculator_changed"],
  "properties": {
    "schema_version": { "const": 1 },
    "date": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["old", "new"],
      "properties": {
        "old": { "type": "string", "format": "date-time" },
        "new": { "type": "string", "format": "date-time" }
      }
    },
    "game": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["old_game_id", "new_game_id"],
      "properties": {
        "old_game_id": { "type": "string", "minLength": 1, "x-entity-id": true },
        "new_game_id": { "type": "string", "minLength": 1, "x-entity-id": true }
      }
    },
    "player_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player_id", "change"],
        "properties": {
          "player_id": { "type": "string", "minLength": 1, "x-entity-id": true },
          "change": { "type": "string", "enum": ["added", "removed", "score"] },
          "old_score": { "type": ["number", "null"] },
          "new_score": { "type": ["number", "null"] }
        }
      }
    },
    "calculator_changed": { "type": "boolean" }
  }
}
