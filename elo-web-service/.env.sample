# Copy and rename this file to .env
# See readme.md for obtaining secrets

ELO_WEB_SERVICE_OAUTH2_CLIENT_ID=
ELO_WEB_SERVICE_OAUTH2_CLIENT_SECRET=
ELO_WEB_SERVICE_COOKIE_JWT_SECRET=
ELO_WEB_SERVICE_POSTGRES_PASSWORD=
ELO_WEB_SERVICE_OAUTH2_USERINFO_URI=

# BoardGameGeek XML API application token (https://boardgamegeek.com/using_the_xml_api).
# Optional: empty disables BGG box-art enrichment. For `make backend-run` put
# it into .env.local (gitignored) instead of .env.
ELO_WEB_SERVICE_BGG_API_ACCESS_TOKEN=